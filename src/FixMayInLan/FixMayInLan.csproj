<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>

    <!-- Giữ .NET 8 dù máy đang cài SDK .NET 10 -->
    <TargetFramework>net8.0-windows</TargetFramework>

    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
<AssemblyName>ToolFixInLan</AssemblyName>
<Product>Tool Fix In LAN</Product>
<Description>Công cụ sửa và kết nối máy in chia sẻ trong mạng LAN</Description>
<Version>1.0.0</Version>

    <!-- File khai báo quyền Administrator -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Hỗ trợ màn hình có tỷ lệ DPI cao -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <RootNamespace>ToolFixInLan</RootNamespace>
    <AssemblyName>ToolFixInLan</AssemblyName>
    <Version>1.0.0</Version>
<AssemblyVersion>1.0.0.0</AssemblyVersion>
<FileVersion>1.0.0.0</FileVersion>

<Product>Tool Fix In LAN</Product>

<Description>
  Công cụ chẩn đoán và xử lý lỗi máy in LAN
</Description>

<Copyright>
  Copyright © 2026
</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>
<ItemGroup>
  <None Update="Assets\logo.png">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
  </None>
</ItemGroup>
</Project>